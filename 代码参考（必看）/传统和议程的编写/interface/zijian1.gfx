# 传统树上的传统图片和传统的图片都需要在interface下制作，前面有说过图片的制作教程
spriteTypes = {
    # 这里已经复制并注册过了
    # 注意这个传统的图片需要放在gfx文件夹下的interface文件夹下的traditions文件夹中
    # 图片格式不知道，但这里使用的是45 X 45 PX,.dds格式
    spriteType = {
        name = "GFX_tr_zijian_1_paleontology"
        textureFile = "gfx/interface/traditions/1.dds"
    }
    spriteType = {
        name = "GFX_tr_zijian_2_paleontology"
        textureFile = "gfx/interface/traditions/2.dds"
    }
    spriteType = {
        name = "GFX_tr_zijian_3_paleontology"
        textureFile = "gfx/interface/traditions/3.dds"
    }
    spriteType = {
        name = "GFX_tr_zijian_4_paleontology"
        textureFile = "gfx/interface/traditions/4.dds"
    }
    spriteType = {
        name = "GFX_tr_zijian_5_paleontology"
        textureFile = "gfx/interface/traditions/5.dds"
    }
    # 现在是注册传统树的小图需要使用
    # GFX_tradition_category_icon_  +  传统的名字，也就是tradition_zijian
    # 加起来就是GFX_tradition_category_icon_tradition_zijian
    # 注意，这个小图的图片需要
    # 放在gfx文件夹下的interface文件夹下的icons文件夹下的traditions文件夹下的tree_icons文件夹中
    # 小图这里的格式是30 X 30，.dds格式
    spriteType = {
        name = "GFX_tradition_category_icon_tradition_zijian"
        textureFile = "gfx/interface/icons/traditions/tree_icons/6.dds"
    }
    # 现在是注册传统树的，这里就是注册这个颜色
    # 同样，需要使用GFX_tradition_hex_bg_  +  tradition_zijian
    # 也就是GFX_tradition_hex_bg_tradition_zijian
    # 图片需要放在gfx文件夹下的interface文件夹下的traditions文件夹中
    spriteType = {
        name = "GFX_tradition_hex_bg_tradition_zijian"
        textureFile = "gfx/interface/traditions/7.dds"
    }
    # 现在是传统树的背景图
    # 需要GFX_tradition_category_bg_  +  tradition_zijian
    # 图片需要放在gfx文件夹下的interface文件夹下的tiles文件夹中
    # 别问为什么这些图片放的文件夹这么乱，问就是蠢驴这么整的，乱放好像会导致显示不正确
    # 现在重进看看
    # 这里使用的图是306x218，.dds格式
    # 传统已经正确的执行了，没有报错，BUFF也在那里
    # 现在写议程
    spriteType = {
        name = "GFX_tradition_category_bg_tradition_zijian"
        textureFile = "gfx/interface/tiles/8.dds"
    }
    # 这里没有图片，使用
    # GFX_council_agenda_icon_agenda_zijianyicheng来注册
    # 也就是GFX_council_agenda_icon_  +  agenda_zijianyicheng
    # 重进一下看看
    # 可以看到选择这个传统后议程正确出现了，现在改口，议程需要使用上面的注册方法
    # 议程文件要在放在gfx/interface/icons/agenda_icons/文件夹下
    # 逆天的蠢驴，就这样
    spriteType = {
        name = "GFX_council_agenda_icon_agenda_zijianyicheng"
        texturefile = "gfx/interface/icons/agenda_icons/agenda_zijianyicheng.dds"
    }
}