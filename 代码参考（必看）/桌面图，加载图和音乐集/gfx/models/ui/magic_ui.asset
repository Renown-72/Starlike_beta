# .asset内有这三个东西
# 第一个entity内的name值不要改就行
# 第二第三个可以随你喜欢
#########################################
entity = {
    name = "frontend_background_entity"
    locator = { name = "loc" position = { 0.0 0.0 0.0 } }
    # position = { 0.0 0.025 0.0 }
    attach = { loc = "magic_ui_attached_entity" }
    # 然后第一个entity下的attach里输入asset文件内第二个entity的name值
}
#########################################
entity = {
    name = "magic_ui_attached_entity"
    pdxmesh = "magic_ui_mesh"
    # 输入GFX文件中pdxmesh里的name值
    default_state = "idle"
    state = {
        name = "idle" animation = "idle" animation_speed = 0.60
        # start_event = { node = "root" particle = "fc_01_front_end_fog" keep_particle = yes trigger_once = yes }
    }
    # position = { x= 5 y = 0 }
    scale = 1
}
#########################################
animation = {
    name = "magic_ui_idle_animation"
    # 第三个里你可以改改名字
    # 然后file输入
    file = "magic_ui.anim"
    # 输入正确的文件名字
}
#########################################
# 其他东西最好不要乱改,看我整的东西改改名字就行