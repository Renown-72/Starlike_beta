music = {
    name = "妖精骑士崔斯坦"
    # 把刚在txt注册的名字放进来
    file = "科尔努诺斯妖精骑士崔斯坦.ogg"
    # 把音乐的 名字 + .ogg格式直接放在file里
    # 音乐需要ogg格式的,你可以整个mp3或者什么格式的直接去格式工厂转换
    # 这里注意一下,蠢驴的音乐播放器有点问题,播放出来的音乐声音有点小
    # 你可以转换时整一下
    volume = 1
    # 值为1即可
}
# 像这样音乐就整好了

# 然后是静态的加载图,在gfx文件夹下的loadingscreens文件夹中
# 这个很简单,整18张 1920 X 1080 的图即可
# 注册方式就是把图片名字改成load_1 load_2 load_3 load_4
# 以此内推有十八张
# 改完名字就行了,格式是,dds 大小 1920 X 1080 十八张,也不一定全要十八张
# 你想整几个整几个
