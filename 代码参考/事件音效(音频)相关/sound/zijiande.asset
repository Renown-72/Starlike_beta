# 需要在sound下进行注册
# 为了找文件找的方便你可以放在sound/vo/下面,这里我放在了sound/vo/zijiande下面
#########################################
category = {
    # 需要使用category来进行注册
    name = Effects
    # 名字,用Effects就行了
    soundeffects = {
        # soundeffects,等下要使用的东西
        zijiande_Effects_1
        zijiande_Effects_2
    }
}
#########################################
# 怎么使用它们呢?


soundeffect = {
    name = zijiande_Effects_1
    # soundeffect的名字,不要重复
    sounds = {
        # 再把你下面sound注册的音效拿来放进去就好了
        # 这里说一下,如果你写多个那就是在播放zijiande_Effects_1的时候在
        # zijiande_Effects_1_1,zijiande_Effects_1_2和zijiande_Effects_1_3
        # 里面随机选择一个进行播放
        sound = zijiande_Effects_1_1
        sound = zijiande_Effects_1_2
        sound = zijiande_Effects_1_3
        # 随机播放的
    }
    volume = 0.6
    # volume,这玩意应该是音量,总之我喜欢写个0.6
}
soundeffect = {
    name = zijiande_Effects_2
    # ------------------------ #

    loop = yes
    # 循环播放 = 是
    # 这个很明显,让你得音频一直进行循环播放
    random_sound_when_looping = no
    # 循环播放时随机播放声音 = 否
    prevent_random_repetition = yes
    # 防止随机重复播放 = 否

    # 这里要说的就是这个就是这loop和它的配套的俩东西了,一般循环播放像这样写就行了
    # 可以让你的音频一直重复循环的播放

    # fade_in = 0.5
    # # 淡入 = 0.5
    # fade_out = 0.5
    # # 淡出 = 0.5
    # 淡入淡出我用的少,如果你需要的话可以使用,你可以慢慢试试这个值
    # ------------------------ #
    sounds = {
        # 如果你只写了一个那很明显,只播放这一个
        sound = zijiande_Effects_2_1
    }
    volume = 0.6
}
# 一般基础的这样就做好了,说一下可能会用到的一些其它值
#########################################
sound = {
    name = zijiande_Effects_1_1
    # 注意名字不要重复
    file = vo/zijiande/1.wav
    # 使用file引入你得文件
    volume = 0.6
}
sound = {
    name = zijiande_Effects_1_2
    file = vo/zijiande/2.wav
    # 使用file引入你得文件
    volume = 0.6
}
sound = {
    name = zijiande_Effects_1_3
    file = vo/zijiande/3.wav
    # 使用file引入你得文件
    volume = 0.6
}
sound = {
    name = zijiande_Effects_2_1
    file = vo/zijiande/d.wav
    volume = 0.6
}
#########################################