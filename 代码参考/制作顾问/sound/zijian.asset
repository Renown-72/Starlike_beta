# 注册音频集
# 如果我们改了开头的,那么这里也需要更改
soundeffect = {
    name = zijiandeguwen_advisor_generic_phrase
    # 顾问_通用短语合集
    # 这个音频集的名字
    sounds = {
        # 这个音频集里的音频有哪些,在这里可以写入多个注册的音频
        # 效果为当触发时随机执行这个音频集里的随机一个音频进行播放
        # 只有一个音频时只会播放这个唯一的音频
        weighted_sound = {
            sound = zijiandeguwen_advisor_generic_phrase_01
            weight = 1000
        }
        weighted_sound = {
            sound = zijiandeguwen_advisor_generic_phrase_02
            weight = 1000
        }
        weighted_sound = {
            sound = zijiandeguwen_advisor_generic_phrase_03
            weight = 1000
        }
        weighted_sound = {
            sound = zijiandeguwen_advisor_generic_phrase_04
            weight = 1000
        }
        weighted_sound = {
            sound = zijiandeguwen_advisor_generic_phrase_05
            weight = 1000
        }
    }
    volume = 1
    # 值为1即可
    max_audible = 1
    # 值为1即可
    max_audible_behaviour = fail
    # 值为fail即可
}

